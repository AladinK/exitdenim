# EXIT Denim — podešavanja okruženja
#
# Za rad na svom računaru: kopirajte ovaj fajl u .env.local i popunite vrednosti.
# Na hostingu: ista imena unesite u podešavanja projekta (Environment Variables).
# Tajne vrednosti nikada ne idu u git.

# ── Baza (Supabase) ── OBAVEZNO ──────────────────────────────────────────────
# Javne vrednosti (smeju da budu u pregledaču). Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://VAS-PROJEKAT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# TAJNO, samo na serveru: "secret" (service_role) ključ sa iste stranice.
# Bez njega ne rade porudžbine, administracija ni fotografije proizvoda.
SUPABASE_SERVICE_ROLE_KEY=

# ── Obaveštenja o porudžbinama ── podesite BAR JEDNO ─────────────────────────
# Telegram: poruka vlasniku čim stigne porudžbina (bot pravite kod @BotFather).
TELEGRAM_BOT_TOKEN=
# Kome bot piše. Ako se izostavi, koristi se nalog vlasnika upisan u kodu.
TELEGRAM_CHAT_ID=

# E-mail preko Resend-a: potvrda kupcu i obaveštenje vlasniku.
RESEND_API_KEY=
EMAIL_FROM="EXIT Denim <porudzbine@exitdenim.shop>"
EMAIL_REPLY_TO=office@bennelijeans.com
# Na koju adresu stiže obaveštenje o novoj porudžbini.
ORDER_NOTIFY_EMAIL=office@bennelijeans.com

# ── Opciono ─────────────────────────────────────────────────────────────────
# Adresa sajta, za linkove u PDF katalogu. Podrazumevano https://exitdenim.shop
SITE_URL=https://exitdenim.shop

# Dugme "AI popuni" u administraciji proizvoda (OpenAI-kompatibilan servis).
# Bez ovoga se podaci o proizvodu unose ručno; ostatak sajta radi normalno.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Hosting se bira sam na Vercel-u, Netlify-ju i Cloudflare Pages-u.
# Za ostale navedite cilj, npr. cloudflare-module ili node-server:
# NITRO_PRESET=node-server
